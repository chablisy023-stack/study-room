{
  "rules": {
    "presence": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "!newData.exists() || (newData.child('name').isString() && newData.child('name').val().length <= 16 && newData.child('subject').isString() && newData.child('subject').val().length <= 30)"
      }
    },
    "messages": {
      ".read": "auth != null",
      ".indexOn": ["ts"],
      "$id": {
        ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid",
        ".validate": "newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 200 && newData.child('name').isString() && newData.child('name').val().length <= 16"
      }
    },
    "stats": {
      ".read": "auth != null",
      "$day": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.child('secs').isNumber() && newData.child('secs').val() <= 86400"
        }
      }
    }
  }
}
